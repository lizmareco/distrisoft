  idOrdenProduccion     Int?          @map("id_orden_produccion")
  motivo                String?       @map("motivo") @db.VarChar(100)
  observacion           String?       @db.VarChar(500)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime?     @default(now()) @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  producto              Producto      @relation(fields: [idProducto], references: [idProducto], onDelete: NoAction, onUpdate: NoAction, map: "inventario_producto_producto_fk")
  ordenProduccion       OrdenProduccion? @relation(fields: [idOrdenProduccion], references: [idOrdenProduccion], onDelete: NoAction, onUpdate: NoAction, map: "inventario_producto_orden_produccion_fk")
}

model Formula {
  idFormula     Int              @id @default(autoincrement()) @map("id_formula")
  idProducto    Int              @map("id_producto")
  nombre        String           @db.VarChar(100)
  descripcion   String?          @db.Text
  rendimiento   Int
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime?         @default(now()) @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  producto      Producto         @relation(fields: [idProducto], references: [idProducto])
  FormulaDetalle FormulaDetalle[]
  Produccion    Produccion[]
}

model FormulaDetalle {
  idFormulaDetalle Int          @id @default(autoincrement()) @map("id_formula_detalle")
  idFormula       Int           @map("id_formula")
  idMateriaPrima  Int           @map("id_materia_prima")
  cantidad        Float
  unidadMedida    String        @map("unidad_medida") @db.VarChar(20)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime?       @default(now()) @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  formula         Formula       @relation(fields: [idFormula], references: [idFormula])
  materiaPrima    MateriaPrima  @relation(fields: [idMateriaPrima], references: [idMateriaPrima])
}

model Produccion {
  idProduccion     Int          @id @default(autoincrement()) @map("id_produccion")
  idFormula        Int          @map("id_formula")
  idProducto       Int          @map("id_producto")
  cantidadProducida Int         @map("cantidad_producida")
  fechaProduccion  DateTime     @default(now()) @map("fecha_produccion")
  idUsuario        Int          @map("id_usuario")
  observaciones    String?      @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime?       @default(now()) @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  formula          Formula      @relation(fields: [idFormula], references: [idFormula])
  producto         Producto     @relation(fields: [idProducto], references: [idProducto])
  usuario          Usuario      @relation(fields: [idUsuario], references: [idUsuario])
  ordenProduccion  OrdenProduccion? @relation(fields: [idOrdenProduccion], references: [idOrdenProduccion])
  idOrdenProduccion Int?        @map("id_orden_produccion")
}

model DetalleFacturaCliente {
  idDetalleFactura     Int                @id @default(autoincrement()) @map("id_detalle_factura")
  nroFactura           Int                @map("nro_factura")
  idProducto           Int                @map("id_producto")
  cantidad             Int                @map("cantidad")
  precioUnitario       Float              @map("precio_unitario")
  idImpuesto           Int                @map("id_impuesto")
  subtotal             Float              @map("subtotal")
  montoImpuesto        Float              @map("monto_impuesto")
  totalLinea           Float              @map("total_linea")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  
  facturaCliente       FacturaCliente     @relation(fields: [nroFactura], references: [nroFactura])
  producto             Producto           @relation(fields: [idProducto], references: [idProducto])
  impuesto             Impuestos          @relation(fields: [idImpuesto], references: [idImpuesto])
  notas                DetalleNotaCredito[]

  @@map("DetalleFacturaCliente")
}

model CuentaPorCobrar {
  idCuentaCobrar       Int                @id @default(autoincrement()) @map("id_cuenta_cobrar")
  nroFactura           Int                @unique @map("nro_factura")
  idCliente            Int                @map("id_cliente")
  montoOriginal        Float              @map("monto_original")
  saldoRestante        Float              @map("saldo_restante")
  fechaVencimiento     DateTime           @map("fecha_vencimiento") @db.Timestamp(6)
  diasVencido          Int                @default(0) @map("dias_vencido")
  idEstadoCuenta       Int                @map("id_estado_cuenta")
  observaciones        String?            @map("observaciones") @db.VarChar
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  
  facturaCliente       FacturaCliente     @relation(fields: [nroFactura], references: [nroFactura])
  cliente              Cliente            @relation(fields: [idCliente], references: [idCliente])
  estadoCuenta         EstadoCuentaCobrar @relation(fields: [idEstadoCuenta], references: [idEstadoCuenta])
  pagos                PagoFacturaCliente[]

  @@map("CuentaPorCobrar")
}

model EstadoCuentaCobrar {
  idEstadoCuenta       Int                @id @default(autoincrement()) @map("id_estado_cuenta")
  descEstadoCuenta     String             @map("desc_estado_cuenta") @db.VarChar
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  
  cuentasPorCobrar     CuentaPorCobrar[]

  @@map("EstadoCuentaCobrar")
}

model PagoFacturaCliente {
  idPago               Int                @id @default(autoincrement()) @map("id_pago")
  nroFactura           Int                @map("nro_factura")
  idCuentaCobrar       Int?               @map("id_cuenta_cobrar")
  fechaPago            DateTime           @map("fecha_pago") @db.Timestamp(6)
  montoPago            Float              @map("monto_pago")
  idMetodoPago         Int                @map("id_metodo_pago")
  comprobantePago      String?            @map("comprobante_pago") @db.VarChar
  observaciones        String?            @map("observaciones") @db.VarChar
  operador             Int                @map("operador")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  
  facturaCliente       FacturaCliente     @relation(fields: [nroFactura], references: [nroFactura])
  cuentaPorCobrar      CuentaPorCobrar?   @relation(fields: [idCuentaCobrar], references: [idCuentaCobrar])
  metodoPago           MetodoPago         @relation(fields: [idMetodoPago], references: [idMetodoPago])
  usuario              Usuario            @relation(fields: [operador], references: [idUsuario])

  @@map("PagoFacturaCliente")
}

model CuentaPorPagar {
  idCuentaPagar        Int                @id @default(autoincrement()) @map("id_cuenta_pagar")
  idFacturaProveedor   Int                @unique @map("id_factura_proveedor") // Una cuenta por factura
  montoOriginal        Float              @map("monto_original")
  montoPagado          Float              @default(0) @map("monto_pagado")
  saldoRestante        Float              @map("saldo_restante")
  fechaVencimiento     DateTime           @map("fecha_vencimiento") @db.Timestamp(6)
  diasVencido          Int                @default(0) @map("dias_vencido") // Calculado automáticamente
  idEstadoCuenta       Int                @map("id_estado_cuenta")
  observaciones        String?            @map("observaciones") @db.VarChar
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime?          @default(now()) @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  
  // Relaciones
  facturaProveedor     FacturaProveedor   @relation(fields: [idFacturaProveedor], references: [idFacturaProveedor], onDelete: NoAction, onUpdate: NoAction)
  estadoCuenta         EstadoCuentaPagar  @relation(fields: [idEstadoCuenta], references: [idEstadoCuentaPagar], onDelete: NoAction, onUpdate: NoAction)
  
  // Relación con pagos
  pagosFacturaProveedor PagoFacturaProveedor[]

  @@map("CuentaPorPagar")
}

model EstadoCuentaPagar {
  idEstadoCuentaPagar  Int              @id @default(autoincrement()) @map("id_estado_cuenta_pagar")
  descEstadoCuenta     String           @map("desc_estado_cuenta") @db.VarChar(50)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime?        @default(now()) @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  
  // Relaciones
  cuentasPorPagar      CuentaPorPagar[]

  @@map("EstadoCuentaPagar")
}

// Pagos realizados a facturas de proveedores
model PagoFacturaProveedor {
  idPago               Int              @id @default(autoincrement()) @map("id_pago")
  idFacturaProveedor   Int              @map("id_factura_proveedor")
  idCuentaPagar        Int              @map("id_cuenta_pagar")
  fechaPago            DateTime         @map("fecha_pago") @db.Timestamp(6)
  montoPago            Float            @map("monto_pago")
  idMetodoPago         Int              @map("id_metodo_pago")
  comprobantePago      String?          @map("comprobante_pago") @db.VarChar
  observaciones        String?          @map("observaciones") @db.VarChar
  operador             Int              @map("operador") // Usuario que registró el pago
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime?        @default(now()) @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  
  // Relaciones
  facturaProveedor     FacturaProveedor @relation(fields: [idFacturaProveedor], references: [idFacturaProveedor], onDelete: NoAction, onUpdate: NoAction)
  cuentaPorPagar       CuentaPorPagar   @relation(fields: [idCuentaPagar], references: [idCuentaPagar], onDelete: NoAction, onUpdate: NoAction)
  metodoPago           MetodoPago       @relation(fields: [idMetodoPago], references: [idMetodoPago], onDelete: NoAction, onUpdate: NoAction)
  usuario              Usuario          @relation(fields: [operador], references: [idUsuario], onDelete: NoAction, onUpdate: NoAction)

  @@map("PagoFacturaProveedor")
}